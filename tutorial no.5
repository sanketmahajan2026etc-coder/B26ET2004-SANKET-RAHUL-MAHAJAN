#include <iostream>
using namespace std;

// Add two integers
int add(int a, int b) {
    return a + b;
}

// Add two floating-point numbers
float add(float a, float b) {
    return a + b;
}

int main() {
    cout << "Sum of integers: " << add(17, 8) << endl;
    cout << "Sum of floating-point numbers: " << add(19.5f, 87.5f) << endl;

    return 0;
}
