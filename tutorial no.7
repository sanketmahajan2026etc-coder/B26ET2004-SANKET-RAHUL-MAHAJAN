
#include <iostream>
#include <cstring>
using namespace std;

class String
{
    char str[100];

public:
    // Default constructor
    String()
    {
        str[0] = '\0';
        cout << "Default constructor called" << endl;
    }

    // Accept function
    void Accept()
    {
        cout << "Enter a string: ";
        cin.getline(str, 100);
    }

    // Display function
    void Display()
    {
        cout << "The string is: " << str << endl;
    }

    // Destructor
    ~String()
    {
        cout << "Destructor called" << endl;
    }
};

int main()
{
    String s;

    s.Accept();
    s.Display();

    return 0;
}
