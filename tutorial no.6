#include <iostream>

class Complex {
private:
    double real;
    double imag;

public:
    Complex(double r = 0.0, double i = 0.0) : real(r), imag(i) {}

    // Overloading the '+' operator
    // taking a constant reference to another Complex object to avoid unnecessary copying
    Complex operator+(const Complex& other) const {
        return Complex(real + other.real, imag + other.imag);
    }

    // display the complex number
    void display() const {
        if (imag >= 0)
            std::cout << real << " + " << imag << "i" << std::endl;
        else
            std::cout << real << " - " << -imag << "i" << std::endl; // Handles negative imaginary parts cleanly
    }
};

int main() {
    // Creating two complex numbers
    Complex c1(4.5, 3.2);
    Complex c2(1.5, 2.3);

    // Using the overloaded '+' operator
    Complex sum = c1 + c2;

    // Displaying the values and results
    std::cout << "First Complex Number:  ";
    c1.display();

    std::cout << "Second Complex Number: ";
    c2.display();

    std::cout << "Sum:                   ";
    sum.display();

    return 0;
}
