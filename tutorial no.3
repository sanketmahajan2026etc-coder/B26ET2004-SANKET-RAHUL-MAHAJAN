#include <iostream>
using namespace std;

//read
void read(int arr[], int n)
{
    cout << "Enter " << n << " numbers: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
}

//display
void display(int arr[], int n)
{
    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }
    cout << endl;
}

// swap two numbers 
void swap(int &a, int &b)
{
    int temp = a;
    a = b;
    b = temp;
}

// sort the array
void sortArray(int arr[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                swap(arr[j], arr[j + 1]);
            }
        }
    }
}

int main()
{
    int n;

    cout << "Enter the size of the array: ";
    cin >> n;

    int arr[n];

    read(arr, n);

    cout << "Original array: ";
    display(arr, n);

    sortArray(arr, n);

    cout << "Sorted array: ";
    display(arr, n);

    return 0;
}
